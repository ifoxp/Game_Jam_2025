    _onTextStarted:
      m_PersistentCalls:
        m_Calls: []
  - _textToType: I'm the first person to test this. I must build the city and succeed
      in this experiment, or i'll <color=red>DIE</color>.
    _deTypeAfter: 0
    _onTextEnded:
      m_PersistentCalls:
